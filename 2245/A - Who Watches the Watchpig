#include <bits/stdc++.h>
using namespace std;
 
/* --------- Fast Typedefs --------- */
using ll = long long;
 
/* --------- Constants --------- */
static const ll MOD = 1000000007;
static const ll INF = 1e18;
 
/* --------- Fast IO --------- */
#define endl '
'
 
/* --------- Solve Function --------- */
void solve() {
    int n,k;cin>>n>>k;
    string s;cin>>s;
    if(k>n/2){
        cout<<"-1
";
        return;
    }
    int ans=0;
    for(int i=0;i<=k-1;i++){
        if(s[i]=='L'){
            ans++;
            s[i]='R';
        }
    }
    for(int i=n-k;i<=n-1;i++){
        if(s[i]=='R'){
            ans++;
            s[i]='L';
        }
    }
    cout<<ans<<"
";return;
}
 
/* --------- Main --------- */
int32_t main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
 
    return 0;
}